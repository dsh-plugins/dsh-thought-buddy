{
  "name": "@dsh-plugin/dsh-thought-buddy",
  "version": "2.0.0",
  "description": "Animated thinking avatar and emoji companion for the DSH Web UI, with profile-backed configuration.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "gen": "node scripts/gen-data.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build:client": "tsdown --config tsdown.client.config.mjs",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "verify": "node test/verify.mjs",
    "check": "node scripts/check-workflows.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-thought-buddy.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-thought-buddy",
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-thought-buddy/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@dsh-plugin/dsh-loader"
      ],
      "platform": "web"
    }
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh",
    "plugin",
    "deep-diving",
    "grokbot",
    "avatar",
    "emoji"
  ],
  "peerDependencies": {
    "@dsh-plugin/dsh-loader": "^2.0.0-dev.42783642741"
  },
  "devDependencies": {
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "@dsh-plugin/dsh-loader": "2.0.0-dev.42783642741"
  }
}
