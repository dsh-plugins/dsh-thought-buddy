{
  "name": "@dsh-plugin/dsh-thought-buddy",
  "version": "0.2.0",
  "description": "DSH web 插件：在「Deep diving...」状态前插入一个动态小表情 —— GrokBot 风格动画头像（纯 SVG + rAF，移植自 nasawz/GrokBot，无任何运行时依赖），也可切换为 emoji 轮播模式",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "README.zh_CN.md",
    "LICENSE"
  ],
  "scripts": {
    "gen": "node scripts/gen-data.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.client.json && node scripts/build.mjs",
    "verify": "node test/verify.mjs",
    "check": "node scripts/check-workflows.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dsh-plugins/dsh-thought-buddy.git"
  },
  "homepage": "https://github.com/dsh-plugins/dsh-thought-buddy",
  "bugs": {
    "url": "https://github.com/dsh-plugins/dsh-thought-buddy/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web"
    }
  },
  "license": "BSD-3-Clause",
  "keywords": [
    "dsh",
    "plugin",
    "deep-diving",
    "grokbot",
    "avatar",
    "emoji"
  ],
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
